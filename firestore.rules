rules_version = '2';

// The site no longer uses Firestore (data moved to Postgres). These rules lock the old
// database completely, so the customer details stored there stop being public.
//
// Publish: npm run firestore:lock   (or paste into Firebase console → Firestore → Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
