# Copy to .env.local and fill in.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
BETTER_AUTH_SECRET=   # openssl rand -base64 48
BETTER_AUTH_URL=http://localhost:3000   # your site's public URL in production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=   # 12+ characters; used by `npm run admin:seed`

# SEO: your public domain (canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://example.com
# Optional: verification codes from Google Search Console / Bing Webmaster Tools
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
